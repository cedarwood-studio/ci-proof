{
  "name": "ci-proof-node-service",
  "version": "1.0.0",
  "private": true,
  "description": "Sample Node/TypeScript service for the Locomotive CI proof harness.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/pricing.test.ts",
    "test:integration": "vitest run test/server.test.ts",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.4.2",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^5.0.5"
  }
}
